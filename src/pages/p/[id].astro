---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Stars from '../../components/Stars.astro';
import Version from '../../components/Version.astro';
import ReleaseEntry from '../../components/ReleaseEntry.astro';
import { GROUPS, projects, releases, assetUrl, type Project } from '../../lib/ship';
import { ogImage } from '../../lib/og';
import { SITE_URL } from '../../lib/site';
import sharp from 'sharp';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props { project: Project }
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const own = releases.filter((r) => r.project.id === p.id);
// The screenshot's real size, so the page reserves its space before it loads.
const shot = p.shot ? await sharp(`${process.cwd()}/public${p.shot}`).metadata() : null;

// Releases in 4-day buckets over the last 120 days.
const now = Date.now();
const bins = new Array(30).fill(0);
for (const d of p.releaseDates) {
  const age = (now - Date.parse(d)) / 864e5;
  if (age >= 0 && age < 120) bins[29 - Math.floor(age / 4)]++;
}
const peak = Math.max(1, ...bins);

// Lets search engines show it as software, with its version and source.
const schema = [{
  '@type': 'SoftwareApplication',
  '@id': `${SITE_URL}/p/${p.id}#app`,
  name: p.name,
  description: p.tagline,
  url: p.site ?? `${SITE_URL}/p/${p.id}`,
  applicationCategory: p.group === 'themes' ? 'PersonalizationApplication' : 'UtilitiesApplication',
  operatingSystem: 'Linux (Omarchy / Hyprland)',
  ...(p.version ? { softwareVersion: p.version } : {}),
  sameAs: [`https://github.com/${p.repo}`],
  author: { '@id': `${SITE_URL}/#person` },
}];
---
<Base title={`${p.name} | m7sh.dev`} description={`${p.tagline} Latest release, stars and the full changelog.`} path={`/p/${p.id}`} image={ogImage(`/og/p/${p.id}.png`)} imageAlt={`${p.name}: ${p.tagline}`} schema={schema}>
  <div class="wrap proj" style={`--pc:${p.accent}`}>
    <a class="back-link" href={`${base}/#apps`}>← All projects & themes</a>
    <header class="proj-head">
      <Icon project={p} size="lg" />
      <div>
        <h1>{p.name}</h1>
        <div class="meta"><Stars count={p.stars} /><Version project={p} /><span>{GROUPS[p.group]}</span></div>
      </div>
    </header>
    <p class="proj-tagline">{p.tagline}</p>
    <div class="ctas proj-ctas">
      {p.site && <a class="btn btn-primary" href={p.site} target="_blank" rel="noreferrer">Project Hub <span class="arr">→</span></a>}
      <a class="btn btn-ghost" href={`https://github.com/${p.repo}`} target="_blank" rel="noreferrer">GitHub ↗</a>
    </div>
    {p.shot ? (
      <div class="win proj-shot"><div class="bar"><i></i><i></i><i></i><span>{p.name}</span></div><img src={assetUrl(p.shot)} alt={`${p.name} screenshot`} width={shot?.width} height={shot?.height} /></div>
    ) : (
      <div class="win proj-shot">
        <div class="bar"><i></i><i></i><i></i><span>{p.name}</span></div>
        <div style="padding:48px 24px;background:var(--bg2);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;min-height:180px">
          <Icon project={p} size="lg" />
          <span style="font-family:var(--mono);font-size:13px;color:var(--fg2);text-align:center;max-width:540px">{p.tagline}</span>
        </div>
      </div>
    )}

    <div class="rel-chart" aria-hidden="true">{bins.map((n) => <i style={`height:${n ? 20 + (n / peak) * 80 : 6}%;${n ? 'background:var(--pci)' : ''}`}></i>)}</div>
    <div class="meta"><span>releases, last 120 days</span><span style="margin-left:auto">{own.length} recent release{own.length === 1 ? '' : 's'}</span></div>

    <h2 class="eyebrow" style="margin-top:40px">Changelog</h2>
    {own.length
      ? <div class="tl">{own.map((r) => <ReleaseEntry release={r} linkName={false} />)}</div>
      : <p class="meta">Continuous development on GitHub. Check the repository for the latest commits.</p>}
  </div>
</Base>
