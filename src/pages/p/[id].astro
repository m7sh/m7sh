---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Stars from '../../components/Stars.astro';
import Version from '../../components/Version.astro';
import ReleaseEntry from '../../components/ReleaseEntry.astro';
import PixelThumb from '../../components/PixelThumb.astro';
import ThemeInspector from '../../components/ThemeInspector.astro';
import ProjectShowcase from '../../components/ProjectShowcase.astro';
import { GROUPS, LIVE_THEME_MAP, projects, releaseBins, releases, assetUrl, type Project } from '../../lib/ship';
import { ogImage } from '../../lib/og';
import { SITE_URL } from '../../lib/site';
import { ago } from '../../lib/time';
import sharp from 'sharp';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props { project: Project }
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const own = releases.filter((r) => r.project.id === p.id);
// The screenshot's real size, so the page reserves its space before it loads.
const shot = p.shot ? await sharp(`${process.cwd()}/public${p.shot}`).metadata() : null;

// Releases in 4-day buckets over the last 120 days relative to snapshot time.
const bins = releaseBins(p, 30, 120);
const peak = Math.max(1, ...bins);

const githubUrl = `https://github.com/${p.repo}`;
const hasLiveSite = Boolean(p.site && !p.site.startsWith(githubUrl));
const liveTheme = LIVE_THEME_MAP[p.id];
const hasInteractiveDemo = [
  'ame', 'mush-workspace', 'omarchy-media', 'omarchy-iptv',
  'omarchy-f1', 'mush-cricket', 'moviebox-tui', 'desktop-voice-assistant', 'umrah-journey',
].includes(p.id);

const idx = projects.findIndex((item) => item.id === p.id);
const prev = projects[(idx - 1 + projects.length) % projects.length];
const next = projects[(idx + 1) % projects.length];
const peers = projects.filter((item) => item.group === p.group && item.id !== p.id).slice(0, 3);

// Lets search engines show it as software, with its version and source.
const schema = [{
  '@type': 'SoftwareApplication',
  '@id': `${SITE_URL}/p/${p.id}#app`,
  name: p.name,
  description: p.tagline,
  url: p.site ?? `${SITE_URL}/p/${p.id}`,
  applicationCategory: p.group === 'themes' ? 'PersonalizationApplication' : 'UtilitiesApplication',
  operatingSystem: 'Linux (Omarchy / Hyprland)',
  ...(p.version ? { softwareVersion: p.version } : {}),
  sameAs: [githubUrl],
  author: { '@id': `${SITE_URL}/#person` },
}];
---
<Base title={`${p.name} | m7sh.dev`} description={`${p.tagline} Latest release, stars and the full changelog.`} path={`/p/${p.id}`} image={ogImage(`/og/p/${p.id}.png`)} imageAlt={`${p.name}: ${p.tagline}`} schema={schema}>
  <div class="wrap proj" style={`--pc:${p.accent}`}>
    <a class="back-link" href={`${base}/#apps`}>← All projects & themes</a>
    <header class="proj-head">
      <Icon project={p} size="lg" />
      <div>
        <h1>{p.name}</h1>
        <div class="meta"><Stars count={p.stars} /><Version project={p} /><span>{GROUPS[p.group]}</span></div>
      </div>
    </header>
    <p class="proj-tagline">{p.tagline}</p>
    <div class="ctas proj-ctas">
      {hasLiveSite && p.site ? (
        <>
          <a class="btn btn-primary" href={p.site} target="_blank" rel="noreferrer">Visit Live Site <span class="arr">→</span></a>
          <a class="btn btn-ghost" href={githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
        </>
      ) : (
        <a class="btn btn-primary" href={githubUrl} target="_blank" rel="noreferrer">View on GitHub <span class="arr">↗</span></a>
      )}
      {liveTheme && (
        <button type="button" class="btn btn-ghost" data-theme-preview={liveTheme}>Preview theme live</button>
      )}
      <a class="btn btn-ghost" href={`${base}/ship`}>Ship log</a>
    </div>

    {p.install && (
      <div class="proj-install">
        <span class="meta-label">Quick install</span>
        <button type="button" class="copy" data-copy={p.install}>
          <span class="p">$</span>
          <code>{p.install}</code>
          <span class="c">copy</span>
        </button>
      </div>
    )}

    <ThemeInspector project={p} />

    {hasInteractiveDemo && <ProjectShowcase project={p} />}

    {p.shot ? (
      <div class="win proj-shot"><div class="bar"><i></i><i></i><i></i><span>{p.name}</span></div><img src={assetUrl(p.shot)} alt={`${p.name} screenshot`} width={shot?.width} height={shot?.height} /></div>
    ) : !hasInteractiveDemo && (
      <div class="win proj-shot">
        <div class="bar"><i></i><i></i><i></i><span>{p.repo}</span></div>
        <div class="thumb proj-px">
          <PixelThumb project={p} />
        </div>
      </div>
    )}

    <div class="rel-chart" aria-hidden="true">{bins.map((n) => <i style={`height:${n ? 20 + (n / peak) * 80 : 6}%;${n ? 'background:var(--pci)' : ''}`}></i>)}</div>
    <div class="meta"><span>releases, last 120 days</span><span style="margin-left:auto">{own.length} recent release{own.length === 1 ? '' : 's'}</span></div>

    <h2 class="eyebrow" style="margin-top:40px">{own.length ? 'Changelog' : 'Recent Commits'}</h2>
    {own.length ? (
      <div class="tl">{own.map((r) => <ReleaseEntry release={r} linkName={false} />)}</div>
    ) : p.commits.length ? (
      <div class="tl">
        {p.commits.map((c) => (
          <article class="entry" style={`--pc:${p.accent}`}>
            <div class="hd">
              <Icon project={p} size="sm" />
              <span class="nm">{c.message}</span>
              <span class="ver" style={`--pc:${p.accent}`}>{c.sha}</span>
              <time class="t" datetime={c.at} data-ago={c.at}>{ago(c.at)}</time>
            </div>
            <div class="ft2"><a href={c.url} target="_blank" rel="noreferrer">View commit on GitHub ↗</a></div>
          </article>
        ))}
      </div>
    ) : (
      <p class="meta">Continuous development on GitHub. Check <a href={githubUrl} target="_blank" rel="noreferrer" style="color:var(--fg);text-decoration:underline;text-underline-offset:3px">{p.repo}</a> for the latest commits.</p>
    )}

    {peers.length > 0 && (
      <section class="proj-more">
        <h2 class="eyebrow">More in {GROUPS[p.group]}</h2>
        <div class="proj-peers">
          {peers.map((item) => (
            <a class="peer-card glow" style={`--pc:${item.accent}`} href={`${base}/p/${item.id}`}>
              <Icon project={item} size="sm" />
              <div>
                <strong>{item.name}</strong>
                <span>{item.version ?? 'active'}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="proj-nav" aria-label="Project navigation">
      <a href={`${base}/p/${prev.id}`}>← {prev.name}</a>
      <a href={`${base}/p/${next.id}`}>{next.name} →</a>
    </nav>
  </div>
</Base>

<script>
  import '../../scripts/showcase';
</script>
