---
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import ShipCard from '../components/ShipCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import FeaturedBand from '../components/FeaturedBand.astro';
import { GROUPS, days, projectById, projects, releases, releasesPerWeek, stats, within, type Group } from '../lib/ship';
import { ago } from '../lib/time';
import { gridDays } from '../lib/grid';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latest = releases[0] ?? { project: projects[0], tag: 'v2.1.0', at: new Date().toISOString() };
const groups = Object.keys(GROUPS) as Group[];
const byRecent = [...projects].sort((a, b) => (b.releasedAt ?? b.pushedAt).localeCompare(a.releasedAt ?? a.pushedAt));

// Data for the hero canvas and the live activity feed.
const relByDay: Record<string, string[]> = {};
for (const p of projects) for (const d of p.releaseDates) (relByDay[d.slice(0, 10)] ??= []).push(p.name);
const tagsByDay: Record<string, string[]> = {};
for (const r of releases) (tagsByDay[r.at.slice(0, 10)] ??= []).push(`${r.project.name} ${r.tag}`);
const heroData = JSON.stringify({
  days,
  rel: relByDay,
  tags: tagsByDay,
  repos: Object.fromEntries(projects.map((p) => [p.repo, { name: p.name, version: p.version }])),
  // Words the grid spells when clicked, in order.
  releases30: stats.releases30,
  stars: stats.stars,
  apps: projects.map((p) => [p.id, p.name]),
  shapes: ['M7SH.DEV', 'RICE IT!', 'OMARCHY', 'WAYLAND', `★ ${stats.stars}`, 'HI :)'],
}).replace(/</g, '\\u003c');

// Column counts let CSS reserve the grid's height before the canvas lays it out.
const gridCols = { wide: gridDays(days, false).cols, narrow: gridDays(days, true).cols };

const weeks = releasesPerWeek(12);
const maxWeek = Math.max(1, ...weeks.map((w) => w.count));
const busiest = projects
  .map((p) => ({ name: p.name, count: releases.filter((r) => r.project.id === p.id && within(r.at, 30)).length }))
  .filter((x) => x.count)
  .sort((a, b) => b.count - a.count)
  .slice(0, 4);
const termLines = [
  `<span class="p">$</span> <span class="hl">mush releases --per-week --last 12w</span>`,
  '',
  ...weeks.map((w) => `<span class="dim">${w.label.padEnd(7)}</span> <span class="bars">${'█'.repeat(Math.max(w.count ? 1 : 0, Math.round((w.count / maxWeek) * 28)))}</span> <span class="hl">${w.count}</span>`),
  '',
  `<span class="p">$</span> <span class="hl">mush plugins --top 4</span>`,
  `<span class="dim">mush.workspace</span> <span class="hl">QML</span> status bar indicator`,
  `<span class="dim">omarchy-media </span> <span class="hl">MPRIS</span> live playback widget`,
  `<span class="dim">ame           </span> <span class="hl">CLI</span> YouTube Music player`,
  `<span class="dim">qutebrowser   </span> <span class="hl">RICE</span> themed keyboard setup`,
  '',
  // The last prompt takes commands (see home.ts); the block cursor follows the input.
  `<span class="p">$</span> <input id="termIn" class="term-in" aria-label="Terminal: type help and press Enter" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go" /><span class="typed"></span>`,
];
---
<Base title="Mohammed Musharaf | m7sh.dev" description="Linux rice artisan, fluid Wayland widgets, declarative QML status-bar plugins, and minimal terminal tools." path="/">
  <section class="hero" id="hero">
    <canvas aria-hidden="true"></canvas>
    <div class="tip" aria-hidden="true"></div>
    <div class="courier-tip" aria-hidden="true"></div>
    <div class="courier-say" aria-hidden="true"></div>
    <div class="hero-inner wrap">
      <a class="pill rise" id="pill" href={`${base}/ship`}><span class="live"></span><span class="pt"><b style="color:var(--fg)">{latest.project.name} {latest.tag}</b> shipped <span data-ago={latest.at}>{ago(latest.at)}</span></span><span class="arr">→</span></a>
      <div class="graph-slot" id="graphSlot" style={`--cw:${gridCols.wide};--cn:${gridCols.narrow}`} role="img" aria-label="GitHub activity, one square per day"></div>
      <div class="graph-legend rise" style="animation-delay:.9s">
        <span id="graphRange">one square per day</span>
        <span class="sw" aria-hidden="true"><i style="background:var(--bg3)"></i><i style="background:color-mix(in oklab,var(--accent) 30%,var(--bg3))"></i><i style="background:color-mix(in oklab,var(--accent) 60%,var(--bg3))"></i><i style="background:var(--accent)"></i></span>
        <span><i class="rel-key" aria-hidden="true"><i></i></i> something shipped that day</span>
        <span class="live-state" id="liveState" title="Checks GitHub for new activity every minute"><i></i><span>live</span></span>
      </div>
      <div class="textcol">
        <div class="who rise" style="animation-delay:.15s">
          <span class="avatar" id="avatar"><img src={`${base}/images/musharaf-headshot.webp`} alt="Mohammed Musharaf" width="60" height="60" /><i class="dot"></i></span>
          <div class="who-t"><b>Mohammed Musharaf</b><span class="presence" id="presence">Linux Rice Artisan & Developer</span></div>
        </div>
        <h1 class="rise-t" style="animation-delay:.22s" aria-label="I craft fluid Wayland desktop experiences and terminal tools.">
          <span aria-hidden="true">I craft fluid Wayland desktop experiences and<br /><span class="word-wrap"><em id="heroWord">terminal</em><span class="caret" id="heroCaret"></span></span> tools.</span>
        </h1>
        <p class="sub rise" style="animation-delay:.3s">Dedicated to Omarchy Linux, Hyprland ricing, declarative QML status-bar plugins, and minimal keyboard-driven software. Follow along as releases ship.</p>
        <div class="stats rise" style="animation-delay:.38s">
          <div class="stat"><b data-count={stats.releases30} data-count-manual>{stats.releases30}</b><span>releases, last 30 days</span></div>
          <div class="stat"><b data-count={projects.length} data-count-manual>{projects.length}</b><span>projects & themes</span></div>
          <div class="stat"><b data-count={stats.stars} data-count-manual>{stats.stars.toLocaleString('en-US')}</b><span>GitHub stars</span></div>
          <div class="stat"><b data-count={stats.contributions} data-count-manual id="contribStat">{stats.contributions.toLocaleString('en-US')}</b><span>contributions this year</span></div>
        </div>
        <div class="ctas rise" style="animation-delay:.46s"><a class="btn btn-primary" href={`${base}/ship`}>See what shipped <span class="arr">→</span></a><a class="btn btn-ghost" href={`${base}/omarchy`}>Omarchy ecosystem</a></div>
      </div>
    </div>
    <script is:inline type="application/json" id="heroData" set:html={heroData} />
  </section>

  <section class="blk wrap">
    <div class="blk-head rv"><div><p class="eyebrow"><span class="live"></span> Just shipped</p><h2>Fresh off the build server</h2><p>The latest releases, straight from GitHub. This row updates whenever something ships.</p></div><a class="link" href={`${base}/ship`}>Full ship log →</a></div>
    <div class="strip rv">{releases.slice(0, 10).map((r, i) => <ShipCard release={r} index={i} />)}</div>
  </section>

  <section class="blk wrap" id="projects">
    <div class="blk-head rv"><div><p class="eyebrow">Featured Work</p><h2>Where to start</h2></div></div>
    <FeaturedBand />
    <div class="feat2">
      <FeatureCard project={projectById['velvet-dusk']} />
      <FeatureCard project={projectById['omarchy-qutebrowser']} />
    </div>
  </section>

  <section class="blk wrap" id="apps">
    <div class="blk-head rv">
      <div><p class="eyebrow">Ecosystem</p><h2>All {projects.length} creations</h2><p>Every bar plugin, CLI tool and desktop theme with latest version, stars and release activity.</p></div>
      <div class="tabs" id="shelfTabs" role="tablist"><span class="ind"></span>{groups.map((g, i) => <button type="button" role="tab" data-shelf={g} class={i === 0 ? 'on' : ''} aria-selected={i === 0 ? 'true' : 'false'}>{GROUPS[g]}<small>{projects.filter((p) => p.group === g).length}</small></button>)}</div>
    </div>
    <div class="grid3 shelf-anim" id="shelf">{byRecent.map((p) => <AppCard project={p} />)}</div>
  </section>

  <section class="blk wrap">
    <div class="blk-head rv"><div><p class="eyebrow">Momentum</p><h2>Shipping, by the numbers</h2><p>Release counts from GitHub, updated as releases ship.</p></div></div>
    <div class="mom">
      <div class="bignums">
        <div class="bn rv"><b data-count={stats.releases30}>{stats.releases30}</b><span>releases in the last 30 days</span></div>
        <div class="bn rv"><b data-count={stats.shipping30}>{stats.shipping30}</b><span>projects with a release recently</span></div>
        <div class="bn rv"><b data-count={stats.stars}>{stats.stars.toLocaleString('en-US')}</b><span>stars across {projects.length} repos</span></div>
        <div class="bn rv"><b data-count={stats.releases7}>{stats.releases7}</b><span>releases in the last 7 days</span></div>
      </div>
      <div class="term rv" title="Click and type help"><div class="bar"><i></i><i></i><i></i><span>~/m7sh.dev</span></div><pre id="term" data-reveal set:html={termLines.join('\n')} /></div>
    </div>
  </section>

</Base>

<script>
  import '../scripts/home';
</script>
