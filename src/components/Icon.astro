---
import { initials, assetUrl, type Project } from '../lib/ship';

interface Props { project: Project; size?: 'sm' | 'lg' }
const { project, size } = Astro.props;
const iconUrl = assetUrl(project.icon);
---
<span class:list={['ico', size]} style={`--pc:${project.accent}`}>
  {iconUrl ? <img src={iconUrl} alt="" width="28" height="28" loading="lazy" /> : initials(project.name)}
</span>
