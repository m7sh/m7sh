---
import { GROUPS, LIVE_THEME_MAP, projects } from '../lib/ship';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const payload = JSON.stringify({
  base,
  projects: projects.map((p) => ({
    id: p.id,
    name: p.name,
    group: GROUPS[p.group],
    tagline: p.tagline,
    accent: p.accent,
    version: p.version,
    stars: p.stars,
    install: p.install ?? null,
    site: p.site ?? null,
    repo: p.repo,
    theme: LIVE_THEME_MAP[p.id] ?? null,
  })),
}).replace(/</g, '\\u003c');
---
<div class="cmd-backdrop" id="cmdBackdrop" hidden>
  <div class="cmd-modal" role="dialog" aria-modal="true" aria-label="Command palette">
    <div class="cmd-top">
      <span class="cmd-prompt" aria-hidden="true">&gt;</span>
      <input
        id="cmdInput"
        class="cmd-input"
        type="search"
        placeholder="Search projects, themes, install commands, or routes..."
        aria-label="Search projects, themes, or commands"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      />
      <kbd>ESC</kbd>
    </div>
    <div class="cmd-list" id="cmdList" role="listbox" aria-label="Results"></div>
    <div class="cmd-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>Shift</kbd>+<kbd>↵</kbd> copy install</span>
      <span><kbd>T</kbd> theme</span>
    </div>
  </div>
  <script is:inline type="application/json" id="paletteData" set:html={payload} />
</div>
